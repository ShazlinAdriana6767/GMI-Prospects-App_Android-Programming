<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World!"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- GMI Prospect Home Page -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/gmi_background"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@color/gmi_blue">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/gmi_white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/home_tagline"
                    android:textColor="@color/gmi_yellow"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_description"
                    android:textColor="@color/gmi_white"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Programmes -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="@string/explore_programmes"
                android:textColor="@color/gmi_blue"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDiploma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diploma"
                android:textAllCaps="false"
                android:backgroundTint="@color/gmi_blue"
                android:textColor="@color/gmi_white" />

            <Button
                android:id="@+id/btnGapp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gapp"
                android:textAllCaps="false"
                android:backgroundTint="@color/gmi_blue"
                android:textColor="@color/gmi_white" />

            <Button
                android:id="@+id/btnGufp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gufp"
                android:textAllCaps="false"
                android:backgroundTint="@color/gmi_blue"
                android:textColor="@color/gmi_white" />

            <!-- Eligibility Checker -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/check_future"
                android:textColor="@color/gmi_blue"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEligibility"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:text="@string/check_eligibility"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="@color/gmi_red"
                android:textColor="@color/gmi_white" />

            <!-- Enquiry -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/more_information"
                android:textColor="@color/gmi_blue"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/contact_us"
                android:textAllCaps="false"
                android:backgroundTint="@color/gmi_yellow"
                android:textColor="@color/gmi_blue" />

            <Button
                android:id="@+id/btnAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_gmi"
                android:textAllCaps="false"
                android:backgroundTint="@color/gmi_yellow"
                android:textColor="@color/gmi_blue" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
