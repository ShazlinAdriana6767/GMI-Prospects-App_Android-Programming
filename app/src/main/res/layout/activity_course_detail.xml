<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CourseDetailActivity">


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/gmi_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/course_details_title"
                android:textColor="@color/gmi_blue"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="18dp"
                android:background="@color/gmi_blue"
                android:text="@string/programmes_title"
                android:textColor="@color/gmi_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetailDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/course_duration"
                android:textColor="@color/gmi_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtDetailFees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/course_fees"
                android:textColor="@color/gmi_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/course_description_default"
                android:textColor="@color/gmi_gray"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/btnCheckCourseEligibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/check_eligibility"
                android:textAllCaps="false"
                android:backgroundTint="@color/gmi_red"
                android:textColor="@color/gmi_white" />

            <Button
                android:id="@+id/btnBackCourses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/back_to_courses"
                android:textAllCaps="false"
                android:backgroundTint="@color/gmi_blue"
                android:textColor="@color/gmi_white" />

        </LinearLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>