<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/gmi_background"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contact GMI"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/gmi_blue" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Have questions about programmes, admission, or eligibility? Get in touch with German-Malaysian Institute."
                android:textSize="14sp"
                android:textColor="@color/gmi_gray" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Location"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gmi_blue" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="German-Malaysian Institute (GMI)&#10;Jalan Ilmiah, Taman Universiti,&#10;43000 Kajang, Selangor, Malaysia"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/gmi_gray" />

            <Button
                android:id="@+id/btnOpenMaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="View on Google Maps"
                android:textAllCaps="false"
                android:backgroundTint="@color/gmi_blue"
                android:textColor="@color/gmi_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Phone"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gmi_blue" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="+603-8921 9000"
                android:textSize="15sp"
                android:textColor="@color/gmi_gray" />

            <Button
                android:id="@+id/btnCallGmi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Call GMI"
                android:textAllCaps="false"
                android:backgroundTint="@color/gmi_blue"
                android:textColor="@color/gmi_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Email"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gmi_blue" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="marketing@gmi.edu.my"
                android:textSize="15sp"
                android:textColor="@color/gmi_gray" />

            <Button
                android:id="@+id/btnEmailGmi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Send Email"
                android:textAllCaps="false"
                android:backgroundTint="@color/gmi_blue"
                android:textColor="@color/gmi_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Official Website"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gmi_blue" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="www.gmi.edu.my"
                android:textSize="15sp"
                android:textColor="@color/gmi_gray" />

            <Button
                android:id="@+id/btnWebsiteGmi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Visit GMI Website"
                android:textAllCaps="false"
                android:backgroundTint="@color/gmi_red"
                android:textColor="@color/gmi_white" />

            <Button
                android:id="@+id/btnContactBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Back to Home"
                android:textAllCaps="false"
                android:backgroundTint="@color/gmi_blue"
                android:textColor="@color/gmi_white" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
